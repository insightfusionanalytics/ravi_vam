[Unit]
Description=Ravi VAM Strategy Platform (FastAPI/uvicorn)
After=network.target

[Service]
Type=simple
User=chirag
Group=chirag
WorkingDirectory=/home/chirag/ravi_vam
Environment=PATH=/home/chirag/ravi_vam/.venv/bin
# Uncomment and point at real DataBento CSVs if/when available — otherwise
# the app auto-downloads data from Yahoo Finance into ./data on first run.
# Environment=RAVI_DATA_DIR=/home/chirag/ravi_vam/data
ExecStart=/home/chirag/ravi_vam/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 2
Restart=on-failure
RestartSec=5

# Only reachable from nginx on this box, never directly from the internet.
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
